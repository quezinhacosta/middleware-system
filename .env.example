# ==============================================================================
# MIDDLEWARE DISTRIBUÍDO — ARQUIVO DE EXEMPLO DE VARIÁVEIS DE AMBIENTE
# Copie este arquivo para .env localmente: cp .env.example .env
# ==============================================================================

# ------------------------------------------------------------------------------
# Ambiente e Observabilidade
# ------------------------------------------------------------------------------
ENVIRONMENT=development
# Opções válidas: DEBUG, INFO, WARNING, ERROR, CRITICAL
LOG_LEVEL=INFO

# ------------------------------------------------------------------------------
# Mensageria e Conexão com RabbitMQ (AMQP)
# ------------------------------------------------------------------------------
RABBITMQ_HOST=message-broker
RABBITMQ_PORT=5672
RABBITMQ_USER=guest
RABBITMQ_PASS=guest

# ------------------------------------------------------------------------------
# Segurança e Autenticação Stateless (Tokens JWT)
# ------------------------------------------------------------------------------
# Chave secreta compartilhada para validação/assinatura HMAC-SHA256 (mudar em produção)
JWT_SECRET_KEY=super-secret-distributed-middleware-key-change-in-production-2026
JWT_ALGORITHM=HS256
JWT_EXPIRATION_MINUTES=60

# ------------------------------------------------------------------------------
# Parâmetros de Resiliência do Middleware
# ------------------------------------------------------------------------------
# Tempo limite para requisições HTTP entre serviços antes de abortar
HTTP_TIMEOUT_SECONDS=3.0
# Número máximo de retentativas para erros de rede transitórios
MAX_RETRIES=3
# Quantidade de falhas consecutivas para abrir o circuito do Circuit Breaker
CIRCUIT_BREAKER_FAILURE_THRESHOLD=5

# ------------------------------------------------------------------------------
# Endereços e Resolução Interna dos Serviços (Rede Docker)
# ------------------------------------------------------------------------------
ORDER_SERVICE_URL=http://order-service:8000
CATALOG_SERVICE_URL=http://catalog-service:8001

